---
export const prerender = false;
---
<!doctype html>
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Admin · NaturalMedix</title><link rel="stylesheet" href="/css/styles-1.2.8.css" /><style>body{margin:0;background:#f8fafc;color:#111827;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.admin{max-width:1100px;margin:auto;padding:40px 20px}.top{margin-bottom:26px}.eyebrow{color:#64748b}.title{margin:.25rem 0}.nav{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:24px 0}.card{display:block;background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:18px;text-decoration:none;color:#111827}.card strong{display:block;margin-bottom:6px}.panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px;max-width:650px}.input{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:9px;padding:11px 12px;font:inherit;margin-top:7px}.btn{margin-top:10px;border:0;border-radius:9px;padding:11px 15px;background:#111827;color:#fff;font-weight:650;cursor:pointer}.status{min-height:22px}.ok{color:#166534}.error{color:#991b1b}@media(max-width:760px){.nav{grid-template-columns:1fr 1fr}}@media(max-width:480px){.nav{grid-template-columns:1fr}}</style></head>
<body><main class="admin"><div class="top"><div class="eyebrow">NaturalMedix</div><h1 class="title">Administración</h1><p>Catálogo, precios por cantidad, categorías y pedidos.</p></div><nav class="nav"><a class="card" href="/admin/productos"><strong>Productos</strong><span>Ver y editar catálogo</span></a><a class="card" href="/admin/productos/nuevo"><strong>Nuevo producto</strong><span>Crear ficha y precios</span></a><a class="card" href="/admin/categorias"><strong>Categorías</strong><span>Organizar catálogo</span></a><a class="card" href="/admin/pedidos"><strong>Pedidos</strong><span>Operación de ventas</span></a></nav><section class="panel"><h2>Sesión de administrador</h2><label for="token">Token de administrador</label><input class="input" id="token" type="password" autocomplete="off" placeholder="Pega tu token local"><button id="save" class="btn">Guardar sesión y abrir productos</button><p id="status" class="status"></p></section></main><script is:inline>const k='naturalmedix_admin_token';const input=document.querySelector('#token');const status=document.querySelector('#status');input.value=sessionStorage.getItem(k)||'';document.querySelector('#save').onclick=()=>{const value=input.value.trim();if(!value){status.className='status error';status.textContent='Escribe el token.';return}sessionStorage.setItem(k,value);status.className='status ok';status.textContent='Sesión guardada. Abriendo productos…';setTimeout(()=>location.href='/admin/productos',250)};</script></body></html>
