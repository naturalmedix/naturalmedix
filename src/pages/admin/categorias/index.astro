---
export const prerender = false;
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Categorías · Admin · NaturalMedix</title><link rel="stylesheet" href="/css/styles-1.2.8.css" /><style>body{margin:0;background:#f8fafc;color:#111827;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.admin{max-width:1000px;margin:auto;padding:32px 20px 60px}.top{display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap}.title{margin:.25rem 0}.panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px;margin-top:18px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.field{display:grid;gap:6px}.input{box-sizing:border-box;width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:10px 12px;font:inherit}.check{display:flex;gap:8px;align-items:center}.btn{border:1px solid #cbd5e1;border-radius:9px;padding:10px 14px;background:#fff;cursor:pointer;font-weight:650}.btn.primary{background:#111827;color:#fff;border-color:#111827}.list{display:grid;gap:10px}.row{display:grid;grid-template-columns:1fr auto;gap:15px;border:1px solid #e2e8f0;border-radius:12px;padding:15px;background:#fff}.muted{color:#64748b;font-size:.9rem}.status{display:inline-block;border-radius:999px;padding:4px 8px;font-size:.78rem;font-weight:700}.on{background:#dcfce7;color:#166534}.off{background:#fee2e2;color:#991b1b}.error{color:#991b1b}.ok{color:#166534}@media(max-width:700px){.grid{grid-template-columns:1fr}.row{grid-template-columns:1fr}}</style></head>
<body><main class="admin"><div class="top"><div><a href="/admin">← Admin</a><h1 class="title">Categorías</h1><div class="muted">Organiza el catálogo sin duplicar productos.</div></div></div>
<section class="panel"><h2 id="formTitle">Nueva categoría</h2><form id="form"><input type="hidden" name="id"><div class="grid"><div class="field"><label>Nombre *</label><input class="input" name="name" required></div><div class="field"><label>Slug *</label><input class="input" name="slug" required></div><div class="field"><label>Orden</label><input class="input" name="sortOrder" type="number" value="0"></div></div><p><label class="check"><input name="active" type="checkbox" checked> Categoría activa</label></p><button class="btn primary" type="submit">Guardar categoría</button> <button class="btn" type="button" id="cancel" hidden>Cancelar edición</button><span id="msg"></span></form></section>
<section class="panel"><h2>Categorías existentes</h2><div id="list" class="list">Cargando…</div></section></main>
<script is:inline>
const token=sessionStorage.getItem('naturalmedix_admin_token')||'';const headers={Authorization:'Bearer '+token,'content-type':'application/json'};const form=document.querySelector('#form'),list=document.querySelector('#list'),msg=document.querySelector('#msg'),cancel=document.querySelector('#cancel');let categories=[];
const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
function render(){list.innerHTML=categories.length?categories.map(c=>`<div class="row"><div><strong>${esc(c.name)}</strong> <span class="status ${c.active?'on':'off'}">${c.active?'Activa':'Inactiva'}</span><div class="muted">/${esc(c.slug)} · Orden ${Number(c.sort_order||0)}</div></div><div><button class="btn" data-edit="${esc(c.id)}">Editar</button></div></div>`).join(''):'<div class="muted">No hay categorías.</div>';list.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>edit(b.dataset.edit))}
function reset(){form.reset();form.id.value='';form.active.checked=true;document.querySelector('#formTitle').textContent='Nueva categoría';cancel.hidden=true;msg.textContent=''}
function edit(id){const c=categories.find(x=>String(x.id)===String(id));if(!c)return;form.id.value=c.id;form.name.value=c.name;form.slug.value=c.slug;form.sortOrder.value=c.sort_order||0;form.active.checked=!!c.active;document.querySelector('#formTitle').textContent='Editar categoría';cancel.hidden=false;window.scrollTo({top:0,behavior:'smooth'})}
cancel.onclick=reset;
form.onsubmit=async e=>{e.preventDefault();msg.className='';msg.textContent='Guardando…';const data=Object.fromEntries(new FormData(form));data.active=form.active.checked;data.sortOrder=Number(data.sortOrder||0);if(!data.id)data.id=Math.random().toString(36).slice(2,10);const r=await fetch('/api/admin/categories',{method:'POST',headers,body:JSON.stringify(data)});const d=await r.json();if(!r.ok){msg.className='error';msg.textContent=d.error||'No se pudo guardar.';return}msg.className='ok';msg.textContent='Guardado.';reset();load()};
async function load(){const r=await fetch('/api/admin/categories',{headers});const d=await r.json();if(!r.ok){list.innerHTML=`<div class="error">${esc(d.error||'No autorizado')}. Ve a <a href="/admin">/admin</a> y guarda tu token.</div>`;return}categories=d.categories||[];render()}load();
</script></body></html>
