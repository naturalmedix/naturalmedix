---
export const prerender = false;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Nuevo producto · Admin · NaturalMedix</title><link rel="stylesheet" href="/css/styles-1.2.8.css" />
<style>
body{margin:0;background:#f8fafc;color:#111827;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.admin{max-width:1050px;margin:auto;padding:30px 20px 70px}.top{display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap}.title{margin:.25rem 0 0}.panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px;margin-top:18px}.section-title{margin:0 0 15px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-weight:650;font-size:.9rem}.field small{color:#64748b}.input,.textarea,.select{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:9px;padding:10px 12px;background:#fff;font:inherit}.textarea{min-height:110px;resize:vertical}.check{display:flex;gap:8px;align-items:center}.tiers{display:grid;gap:8px}.tier{display:grid;grid-template-columns:110px 1fr 150px auto;gap:8px;align-items:center}.btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid #cbd5e1;border-radius:9px;padding:10px 14px;text-decoration:none;color:#111827;background:#fff;cursor:pointer;font-weight:650}.btn.primary{background:#111827;color:#fff;border-color:#111827}.btn.danger{color:#991b1b}.footer{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:20px}.message{min-height:24px}.error{color:#991b1b}.ok{color:#166534}.categories{display:flex;gap:8px;flex-wrap:wrap}.cat{border:1px solid #cbd5e1;border-radius:999px;padding:7px 10px;background:#fff}.cat input{margin-right:5px}@media(max-width:720px){.grid{grid-template-columns:1fr}.tier{grid-template-columns:1fr 1fr}.tier .label{grid-column:1/-1}.tier button{grid-column:1/-1}}
</style>
</head>
<body><main class="admin">
<div class="top"><div><a href="/admin/productos">← Productos</a><h1 class="title">Nuevo producto</h1></div></div>
<form id="form">
<section class="panel"><h2 class="section-title">Información principal</h2><div class="grid">
<div class="field"><label for="name">Nombre *</label><input class="input" id="name" name="name" required /></div>
<div class="field"><label for="slug">Slug URL *</label><input class="input" id="slug" name="slug" required /><small>Ejemplo: origen-30-comprimidos</small></div>
<div class="field"><label for="id">ID interno</label><input class="input" id="id" name="id" placeholder="Se genera automáticamente si lo dejas vacío" /></div>
<div class="field"><label for="stock">Stock</label><input class="input" id="stock" name="stock" type="number" min="0" value="0" /></div>
<div class="field"><label for="minimumOrderQuantity">Cantidad mínima de pedido</label><input class="input" id="minimumOrderQuantity" name="minimumOrderQuantity" type="number" min="1" value="1" /></div>
<div class="field"><label for="sortOrder">Orden</label><input class="input" id="sortOrder" name="sortOrder" type="number" value="0" /></div>
<div class="field"><label for="brand">Marca</label><input class="input" id="brand" name="brand" /></div>
<div class="field"><label for="laboratory">Laboratorio</label><input class="input" id="laboratory" name="laboratory" /></div>
<div class="field"><label for="line">Línea</label><input class="input" id="line" name="line" /></div>
<div class="field"><label for="invima">INVIMA</label><input class="input" id="invima" name="invima" /></div>
<div class="field"><label for="netContent">Contenido neto</label><input class="input" id="netContent" name="netContent" placeholder="Ej. 30 comprimidos · 18 g" /></div>
<div class="field"><label for="netWeight">Peso neto (g)</label><input class="input" id="netWeight" name="netWeight" type="number" min="0" step="0.01" /></div>
<div class="field"><label for="pum">PUM</label><input class="input" id="pum" name="pum" placeholder="Ej. $1.000 / 100 g" /></div>
<div class="field"><label for="originalPrice">Precio tachado / anterior</label><input class="input" id="originalPrice" name="originalPrice" type="number" min="0" /></div>
<div class="field full"><label for="videoUrl">MP4</label><input class="input" id="videoUrl" name="videoUrl" placeholder="/images/origen_30_comprimidos.mp4 o URL absoluta" /><small>El administrador guarda la ruta del MP4. Los archivos existentes de /public no se modifican.</small></div>
<div class="field full"><label for="description">Descripción</label><textarea class="textarea" id="description" name="description"></textarea></div>
<div class="field full"><label class="check"><input id="active" name="active" type="checkbox" checked /> Producto activo</label></div>
</div></section>
<section class="panel"><h2 class="section-title">Categorías</h2><div id="categories" class="categories">Cargando…</div></section>
<section class="panel"><h2 class="section-title">Precios por cantidad</h2><p>Usa “Desde cantidad”. El precio aplicable es el del nivel más alto que no supere la cantidad comprada.</p><div id="tiers" class="tiers"></div><button type="button" class="btn" id="addTier">+ Agregar nivel</button></section>
<section class="panel"><h2 class="section-title">Badges</h2><div class="grid"><div class="field full"><label for="badges">Badges, uno por línea</label><textarea class="textarea" id="badges" placeholder="Nuevo\nMás vendido\nOferta"></textarea></div></div></section>
<section class="panel"><h2 class="section-title">SEO</h2><div class="grid"><div class="field"><label for="seoTitle">SEO title</label><input class="input" id="seoTitle" name="seoTitle" /></div><div class="field"><label for="seoDescription">SEO description</label><textarea class="textarea" id="seoDescription" name="seoDescription"></textarea></div></div></section>
<div class="footer"><a class="btn" href="/admin/productos">Cancelar</a><div><span id="msg" class="message"></span> <button class="btn primary" type="submit">Guardar producto</button></div></div>
</form>
</main>
<script is:inline>
const token=sessionStorage.getItem('naturalmedix_admin_token')||'';const auth={Authorization:'Bearer '+token};const form=document.querySelector('#form');const tiers=document.querySelector('#tiers');const cats=document.querySelector('#categories');const msg=document.querySelector('#msg');
const slugify=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
function addTier(q=1,p=0,l='Detal'){const d=document.createElement('div');d.className='tier';d.innerHTML=`<input class="input qty" type="number" min="1" value="${q}" aria-label="Desde cantidad"><input class="input price" type="number" min="0" value="${p}" aria-label="Precio COP"><input class="input label" value="${l}" aria-label="Etiqueta"><button type="button" class="btn danger">Eliminar</button>`;d.querySelector('button').onclick=()=>d.remove();tiers.appendChild(d)}
addTier();document.querySelector('#addTier').onclick=()=>addTier(4,0,'Mayorista');
document.querySelector('#name').addEventListener('input',()=>{const slug=document.querySelector('#slug');if(!slug.value)slug.value=slugify(document.querySelector('#name').value)});
async function loadCategories(){const r=await fetch('/api/admin/categories',{headers:auth});const d=await r.json();if(!r.ok){cats.textContent=d.error||'No autorizado';return}cats.innerHTML=(d.categories||[]).map(c=>`<label class="cat"><input type="checkbox" value="${String(c.id).replace(/"/g,'&quot;')}" ${c.active?'':'disabled'}>${c.name}</label>`).join('')||'No hay categorías todavía.'}
form.addEventListener('submit',async e=>{e.preventDefault();msg.className='message';msg.textContent='Guardando…';const data=Object.fromEntries(new FormData(form).entries());data.active=document.querySelector('#active').checked;data.stock=Number(data.stock||0);data.minimumOrderQuantity=Number(data.minimumOrderQuantity||1);data.sortOrder=Number(data.sortOrder||0);data.originalPrice=Number(data.originalPrice||0);data.netWeight=Number(data.netWeight||0);data.categoryIds=[...cats.querySelectorAll('input[type=checkbox]:checked')].map(x=>x.value);data.badges=document.querySelector('#badges').value.split('\n').map(x=>x.trim()).filter(Boolean);data.priceTiers=[...tiers.children].map(x=>({minimumQuantity:Number(x.querySelector('.qty').value),price:Number(x.querySelector('.price').value),label:x.querySelector('.label').value})).sort((a,b)=>a.minimumQuantity-b.minimumQuantity);const r=await fetch('/api/admin/products',{method:'POST',headers:{...auth,'content-type':'application/json'},body:JSON.stringify(data)});const d=await r.json();if(!r.ok){msg.className='message error';msg.textContent=d.error||'No se pudo guardar.';return}msg.className='message ok';msg.textContent='Producto guardado.';setTimeout(()=>location.href='/admin/productos',500)});loadCategories();
</script></body></html>
