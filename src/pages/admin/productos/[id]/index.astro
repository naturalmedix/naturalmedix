---
export const prerender = false;
const { id } = Astro.params;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Editar producto · Admin · NaturalMedix</title><link rel="stylesheet" href="/css/styles-1.2.8.css" />
<style>
body{margin:0;background:#f8fafc;color:#111827;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.admin{max-width:1050px;margin:auto;padding:30px 20px 70px}.top{display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap}.title{margin:.25rem 0 0}.panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px;margin-top:18px}.section-title{margin:0 0 15px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-weight:650;font-size:.9rem}.field small,p{color:#64748b}.input,.textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:9px;padding:10px 12px;background:#fff;font:inherit}.textarea{min-height:110px;resize:vertical}.check{display:flex;gap:8px;align-items:center}.tiers{display:grid;gap:8px}.tier{display:grid;grid-template-columns:110px 1fr 150px auto;gap:8px;align-items:center}.btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid #cbd5e1;border-radius:9px;padding:10px 14px;text-decoration:none;color:#111827;background:#fff;cursor:pointer;font-weight:650}.btn.primary{background:#111827;color:#fff;border-color:#111827}.btn.danger{color:#991b1b}.footer{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:20px}.message{min-height:24px}.error{color:#991b1b}.ok{color:#166534}.categories{display:flex;gap:8px;flex-wrap:wrap}.cat{border:1px solid #cbd5e1;border-radius:999px;padding:7px 10px;background:#fff}.cat input{margin-right:5px}@media(max-width:720px){.grid{grid-template-columns:1fr}.tier{grid-template-columns:1fr 1fr}.tier .label{grid-column:1/-1}.tier button{grid-column:1/-1}}
</style>
</head>
<body data-product-id={id}><main class="admin">
<div class="top"><div><a href="/admin/productos">← Productos</a><h1 class="title">Editar producto</h1><p id="subtitle">Cargando…</p></div></div>
<form id="form" hidden>
<section class="panel"><h2 class="section-title">Información principal</h2><div class="grid">
<div class="field"><label for="name">Nombre *</label><input class="input" id="name" name="name" required /></div><div class="field"><label for="slug">Slug URL *</label><input class="input" id="slug" name="slug" required /></div>
<div class="field"><label for="id">ID interno</label><input class="input" id="id" name="id" readonly /></div><div class="field"><label for="stock">Stock</label><input class="input" id="stock" name="stock" type="number" min="0" /></div>
<div class="field"><label for="minimumOrderQuantity">Cantidad mínima de pedido</label><input class="input" id="minimumOrderQuantity" name="minimumOrderQuantity" type="number" min="1" /></div><div class="field"><label for="sortOrder">Orden</label><input class="input" id="sortOrder" name="sortOrder" type="number" /></div>
<div class="field"><label for="brand">Marca</label><input class="input" id="brand" name="brand" /></div><div class="field"><label for="laboratory">Laboratorio</label><input class="input" id="laboratory" name="laboratory" /></div>
<div class="field"><label for="line">Línea</label><input class="input" id="line" name="line" /></div><div class="field"><label for="invima">INVIMA</label><input class="input" id="invima" name="invima" /></div>
<div class="field"><label for="netContent">Contenido neto</label><input class="input" id="netContent" name="netContent" /></div><div class="field"><label for="netWeight">Peso neto (g)</label><input class="input" id="netWeight" name="netWeight" type="number" min="0" step="0.01" /></div>
<div class="field"><label for="pum">PUM</label><input class="input" id="pum" name="pum" /></div><div class="field"><label for="originalPrice">Precio tachado / anterior</label><input class="input" id="originalPrice" name="originalPrice" type="number" min="0" /></div>
<div class="field full"><label for="videoUrl">MP4</label><input class="input" id="videoUrl" name="videoUrl" /></div><div class="field full"><label for="description">Descripción</label><textarea class="textarea" id="description" name="description"></textarea></div>
<div class="field full"><label class="check"><input id="active" type="checkbox" checked /> Producto activo</label></div>
</div></section>
<section class="panel"><h2 class="section-title">Categorías</h2><div id="categories" class="categories">Cargando…</div></section>
<section class="panel"><h2 class="section-title">Precios por cantidad</h2><p>El precio aplicable es el del nivel más alto que no supere la cantidad comprada.</p><div id="tiers" class="tiers"></div><button type="button" class="btn" id="addTier">+ Agregar nivel</button></section>
<section class="panel"><h2 class="section-title">Badges</h2><textarea class="textarea" id="badges" placeholder="Uno por línea"></textarea></section>
<section class="panel"><h2 class="section-title">SEO</h2><div class="grid"><div class="field"><label for="seoTitle">SEO title</label><input class="input" id="seoTitle" name="seoTitle" /></div><div class="field"><label for="seoDescription">SEO description</label><textarea class="textarea" id="seoDescription" name="seoDescription"></textarea></div></div></section>
<div class="footer"><a class="btn" href="/admin/productos">Cancelar</a><div><span id="msg" class="message"></span> <button class="btn primary" type="submit">Guardar cambios</button></div></div>
</form><div id="error" class="panel error" hidden></div>
</main>
<script is:inline>
const currentProductId = document.body.dataset.productId || '';const token=sessionStorage.getItem('naturalmedix_admin_token')||'';const auth={Authorization:'Bearer '+token};const form=document.querySelector('#form'),tiers=document.querySelector('#tiers'),cats=document.querySelector('#categories'),msg=document.querySelector('#msg');
function set(name,value){const el=document.querySelector('[name="'+name+'"]');if(el)el.value=value??''}function addTier(t={minimumQuantity:1,price:0,label:'Detal',active:true}){const d=document.createElement('div');d.className='tier';d.innerHTML=`<input class="input qty" type="number" min="1" value="${Number(t.minimumQuantity||1)}"><input class="input price" type="number" min="0" value="${Number(t.price||0)}"><input class="input label" value="${String(t.label||'').replace(/"/g,'&quot;')}"><button type="button" class="btn danger">Eliminar</button>`;d.querySelector('button').onclick=()=>d.remove();tiers.appendChild(d)}
async function load(){const r=await fetch('/api/admin/products',{headers:auth});const d=await r.json();if(!r.ok){document.querySelector('#error').hidden=false;document.querySelector('#error').textContent=d.error||'No autorizado';return}const p=(d.products||[]).find(x=>x.id===currentProductId);if(!p){document.querySelector('#error').hidden=false;document.querySelector('#error').textContent='Producto no encontrado.';return}form.hidden=false;document.querySelector('#subtitle').textContent='ID: '+p.id;set('id',p.id);set('name',p.name);set('slug',p.slug);set('stock',p.stock);set('minimumOrderQuantity',p.minimumOrderQuantity||1);set('sortOrder',p.sortOrder||0);set('brand',p.brand);set('laboratory',p.laboratory);set('line',p.line);set('invima',p.invima);set('netContent',p.netContent);set('netWeight',p.netWeight);set('pum',p.pum);set('originalPrice',p.originalPrice);set('videoUrl',p.videoUrl);set('description',p.description);set('seoTitle',p.seoTitle);set('seoDescription',p.seoDescription);document.querySelector('#active').checked=!!p.active;document.querySelector('#badges').value=(p.badges||[]).join('\n');(p.priceTiers||[]).forEach(addTier);if(!tiers.children.length)addTier();document.querySelector('#addTier').onclick=()=>addTier({minimumQuantity:4,price:0,label:'Mayorista'});await loadCategories(p.categories||[])}
async function loadCategories(selected){const r=await fetch('/api/admin/categories',{headers:auth});const d=await r.json();if(!r.ok){cats.textContent=d.error||'No autorizado';return}const ids=new Set(selected.map(c=>String(c.id)));cats.innerHTML=(d.categories||[]).map(c=>`<label class="cat"><input type="checkbox" value="${String(c.id).replace(/"/g,'&quot;')}" ${ids.has(String(c.id))?'checked':''} ${c.active?'':'disabled'}>${c.name}</label>`).join('')||'No hay categorías.'}
form.addEventListener('submit',async e=>{e.preventDefault();msg.className='message';msg.textContent='Guardando…';const data=Object.fromEntries(new FormData(form).entries());data.active=document.querySelector('#active').checked;data.stock=Number(data.stock||0);data.minimumOrderQuantity=Number(data.minimumOrderQuantity||1);data.sortOrder=Number(data.sortOrder||0);data.originalPrice=Number(data.originalPrice||0);data.netWeight=Number(data.netWeight||0);data.categoryIds=[...cats.querySelectorAll('input[type=checkbox]:checked')].map(x=>x.value);data.badges=document.querySelector('#badges').value.split('\n').map(x=>x.trim()).filter(Boolean);data.priceTiers=[...tiers.children].map(x=>({minimumQuantity:Number(x.querySelector('.qty').value),price:Number(x.querySelector('.price').value),label:x.querySelector('.label').value})).sort((a,b)=>a.minimumQuantity-b.minimumQuantity);const r=await fetch('/api/admin/products',{method:'POST',headers:{...auth,'content-type':'application/json'},body:JSON.stringify(data)});const d=await r.json();if(!r.ok){msg.className='message error';msg.textContent=d.error||'No se pudo guardar.';return}msg.className='message ok';msg.textContent='Cambios guardados.'});
load();
</script></body></html>
